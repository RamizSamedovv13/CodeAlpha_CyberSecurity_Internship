alert icmp any any -> $HOME_NET any (msg:"LOCAL ICMP Echo Request Detected"; itype:8; sid:1000001; rev:1;)

alert tcp any any -> $HOME_NET any (msg:"LOCAL Possible TCP Port Scan"; flags:S; threshold:type both, track by_src, count 20, seconds 10; sid:1000002; rev:1;)

alert tcp any any -> $HOME_NET 22 (msg:"LOCAL Repeated SSH Connection Attempts"; flags:S; flow:to_server; threshold:type both, track by_src, count 5, seconds 60; sid:1000003; rev:1;)

alert http any any -> $HOME_NET any (msg:"LOCAL HTTP Path Traversal Attempt"; flow:established,to_server; http.uri; content:"../"; sid:1000004; rev:1;)

alert http any any -> $HOME_NET any (msg:"LOCAL Sensitive File Access Attempt"; flow:established,to_server; http.uri; content:"/etc/passwd"; nocase; sid:1000005; rev:1;)
